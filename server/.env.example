PORT=3001
SERVER_HOST=0.0.0.0
CLIENT_ORIGIN=http://localhost:5173
CLIENT_ORIGINS=http://localhost:5173,http://localhost,https://localhost,capacitor://localhost
REPLY_TEXT=Ok
AUTO_START=true
# Danh sách ID nhóm, phân cách bằng dấu phẩy. Để trống = không trả lời nhóm nào.
ALLOWED_GROUP_IDS=
# Danh sách chọn trên giao diện được lưu tại đây; nếu file chưa tồn tại mới dùng ALLOWED_GROUP_IDS.
ALLOWED_GROUPS_FILE=data/allowed-groups.json
# Bắt buộc tự tạo giá trị ngẫu nhiên đủ dài trên VPS. Không commit giá trị thật.
ADMIN_KEY=
SESSION_FILE=data/zca-session.json
QR_FILE=data/zalo-login-qr.png
# Khi bật, chỉ phản hồi tin khớp một tuyến ưu tiên đang bật.
PRIORITY_ONLY=false
PRIORITY_ROUTES_FILE=data/priority-routes.json
BOT_STATE_FILE=data/bot-state.json
MAX_SOCKET_CONNECTIONS=5
# Chi bat khi can debug; log tung tin co the lam tang do tre.
HOT_PATH_LOGGING=false
# Heartbeat Zalo; toi thieu 5000 ms.
KEEP_ALIVE_INTERVAL_MS=5000
# Chu kỳ làm nóng MỖI kết nối gửi tin nhóm (các kết nối làm nóng so le nhau); tối thiểu 5000 ms.
GROUP_PRECONNECT_INTERVAL_MS=5000
# Số kết nối gửi nhóm giữ nóng song song (2-4). Luôn có ít nhất 1 kết nối rảnh khi có cuốc.
GROUP_WARM_CONNECTIONS=2
# Thời gian chờ tối đa một lượt làm nóng; tối thiểu 1000 ms.
GROUP_WARM_UP_TIMEOUT_MS=3000
# Tương thích Redis Server 5 qua RESP2. Nếu dùng requirepass: redis://:MAT_KHAU_URL_ENCODED@127.0.0.1:6379
REDIS_URL=redis://127.0.0.1:6379
REDIS_PREFIX=zalo-auto-reply
REDIS_CHANNEL=priority_routes_updated
REDIS_HEARTBEAT_MS=15000
# TCP tự kết nối lại liên tục; PING định kỳ tránh NAT/firewall cắt socket nhàn rỗi.
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_PING_INTERVAL_MS=10000
# Tat ca ket noi HTTP va WebSocket Zalo dung chung HTTP(S) proxy nay.
ZALO_PROXY_AGENT=
