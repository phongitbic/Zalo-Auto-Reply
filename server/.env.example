PORT=3001
CLIENT_ORIGIN=http://localhost:5173
REPLY_TEXT=Ok
AUTO_START=true
# Danh sách ID nhóm, phân cách bằng dấu phẩy. Để trống = không trả lời nhóm nào.
ALLOWED_GROUP_IDS=546979749790950210
# Chỉ đặt khóa này trên VPS; frontend gửi qua header x-admin-key.
ADMIN_KEY=change-this-long-random-value
SESSION_FILE=./data/zca-session.json
# Khi bật, chỉ phản hồi tin chứa một vị trí trong file bên dưới.
PRIORITY_ONLY=false
PRIORITY_LOCATIONS_FILE=data/priority-locations.txt
PRIORITY_ROUTES_FILE=data/priority-routes.json
# Chi bat khi can debug; log tung tin co the lam tang do tre.
HOT_PATH_LOGGING=false
