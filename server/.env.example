PORT=3001
CLIENT_ORIGIN=http://localhost:5173
CLIENT_ORIGINS=http://localhost:5173,http://localhost,https://localhost,capacitor://localhost
REPLY_TEXT=Ok
AUTO_START=true
# Danh sách ID nhóm, phân cách bằng dấu phẩy. Để trống = không trả lời nhóm nào.
ALLOWED_GROUP_IDS=
# Bắt buộc tự tạo giá trị ngẫu nhiên đủ dài trên VPS. Không commit giá trị thật.
ADMIN_KEY=
SESSION_FILE=data/zca-session.json
QR_FILE=data/zalo-login-qr.png
# Khi bật, chỉ phản hồi tin chứa một vị trí trong file bên dưới.
PRIORITY_ONLY=false
PRIORITY_LOCATIONS_FILE=data/priority-locations.txt
PRIORITY_ROUTES_FILE=data/priority-routes.json
BOT_STATE_FILE=data/bot-state.json
ORDER_HISTORY_FILE=data/order-history.json
MAX_ORDER_HISTORY=500
MAX_SOCKET_CONNECTIONS=5
# Chi bat khi can debug; log tung tin co the lam tang do tre.
HOT_PATH_LOGGING=false
# Heartbeat Zalo; toi thieu 5000 ms.
KEEP_ALIVE_INTERVAL_MS=15000
# Cho phép heartbeat và nhiều lệnh gửi đồng thời mà không chặn nhau.
HTTP_CONNECTIONS=4
# Redis là nguồn cấu hình chính; bot vẫn dùng bản RAM gần nhất khi Redis tạm mất kết nối.
REDIS_URL=redis://127.0.0.1:6379
REDIS_PREFIX=zalo-auto-reply
REDIS_CHANNEL=priority_routes_updated
REDIS_HEARTBEAT_MS=15000
